{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "WahooFetcherOptions": {
    "Enabled": true,
    "InstanceId": "wahoo-fetcher-1",
    "HeartbeatIntervalMinutes": 1,
    "PollIntervalMinutes": 1,
    "FetchIntervalMinutes": 10,
    "LookbackDays": 180,
    "MaxParallelUsers": 4,
    "MaxParallelActivities": 10,
    "MaxSequentialCredentialFailures": 5,
    "Client": {
      "BaseUrl": "https://api.wahooligan.com",
      "ClientId": "dev",
      "ClientSecret": "dev",
      "RateLimits": [
        {
          "WindowMinutes": 5,
          "Cap": 25
        },
        {
          "WindowMinutes": 60,
          "Cap": 100
        },
        {
          "WindowMinutes": 1440,
          "Cap": 250
        }
      ]
    }
  },
  "AllowedHosts": "*"
}
