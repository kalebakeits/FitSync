  "components": {
    "schemas": {
      "ActivityResponse": {
        "required": [
          "activityDate",
          "createdAt",
          "externalActivityId",
          "id",
          "source",
          "updatedAt"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "externalActivityId": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "originalFileName": {
            "type": "string",
            "nullable": true
          },
          "fileSizeBytes": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          },
          "activityDate": {
            "type": "string",
            "format": "date-time"
          },
          "activityName": {
            "type": "string",
            "nullable": true
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "uploadStatuses": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UploadStatusEntry"
            }
          }
        },
        "additionalProperties": false
      },
      "ActivityStatus": {
        "enum": [
          "Pending",
          "Claimed",
          "Processing",
          "Uploaded",
          "Failed",
          "Conflict",
          "ServiceUnavailable"
        ],
        "type": "string"
      },
      "AuthSuccessResponse": {
        "required": [
          "userId",
          "username"
        ],
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "username": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "AvailableServiceResponse": {
        "required": [
          "authType",
          "serviceType"
        ],
        "type": "object",
        "properties": {
          "serviceType": {
            "type": "string"
          },
          "authType": {
            "type": "string"
          },
          "connectUrl": {
            "type": "string",
            "nullable": true
          },
          "isFetcher": {
            "type": "boolean"
          },
          "isUploader": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "ConfirmPasswordResetRequest": {
        "required": [
          "newPassword",
          "token"
        ],
        "type": "object",
        "properties": {
          "token": {
            "minLength": 1,
            "type": "string"
          },
          "newPassword": {
            "maxLength": 100,
            "minLength": 8,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "ConnectionResponse": {
        "required": [
          "authType",
          "connected",
          "enabled",
          "serviceType",
          "updatedAt"
        ],
        "type": "object",
        "properties": {
          "serviceType": {
            "type": "string"
          },
          "authType": {
            "type": "string"
          },
          "connected": {
            "type": "boolean"
          },
          "enabled": {
            "type": "boolean"
          },
          "displayName": {
            "type": "string",
            "nullable": true
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      },
      "CreateCredentialRequest": {
        "required": [
          "password",
          "serviceType",
          "username"
        ],
        "type": "object",
        "properties": {
          "serviceType": {
            "minLength": 1,
            "type": "string"
          },
          "username": {
            "minLength": 1,
            "type": "string"
          },
          "password": {
            "minLength": 1,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "CredentialResponse": {
        "required": [
          "createdAt",
          "enabled",
          "serviceType",
          "updatedAt",
          "username"
        ],
        "type": "object",
        "properties": {
          "serviceType": {
            "type": "string"
          },
          "username": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "enabled": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "CurrentUserResponse": {
        "required": [
          "email",
          "isEmailVerified",
          "isVerified",
          "userId",
          "username"
        ],
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "username": {
            "type": "string"
          },
          "email": {
